APP_NAME="HabitFlow"
APP_ENV="production"
HOST="0.0.0.0"
PORT=8000

# Часовой пояс владельца (гарантирует одинаковую дату «сегодня» на телефоне, ноутбуке и сервере)
OWNER_TIMEZONE="Asia/Almaty"

# База данных:
# 1) Для VPS / Docker / Render с постоянным диском (Persistent Disk):
DATABASE_URL="sqlite:///./habitflow.db"
# 2) Для облачного хостинга с временной файловой системой (Render Free / Railway / Fly / Neon Postgres):
# DATABASE_URL="postgresql://user:password@host:5432/habitflow"

# Безопасность и доступ единственного владельца:
# Сгенерируйте секретный ключ: python3 -m app.auth --generate-secret
SECRET_KEY="replace-with-output-of-python3-m-app-auth-generate-secret"

# Логин владельца
OWNER_USERNAME="owner"

# Сгенерируйте хеш пароля: python3 -m app.auth --hash-password "ваш_надёжный_пароль"
OWNER_PASSWORD_HASH="pbkdf2_sha256$260000$replace_with_generated_hash"
# В режиме локальной разработки можно использовать OWNER_PASSWORD вместо OWNER_PASSWORD_HASH:
# OWNER_PASSWORD="change-me-locally"

FREE_PLAN_MAX_HABITS=10
